  <li>MedievalMeleeBasic</li>
  <li>MedievalMeleeAdvanced</li>
  </weaponTags>

<skills>
  <li>
      <skill>Melee</skill>
      <range>6~14</range>
    </li>
    <li>
      <skill>Shooting</skill>
      <range>5~10</range>
    </li>	  
  </skills>
</PawnKindDef>  

